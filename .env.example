# Application settings only. Keep the platform bundle's .env in its own folder.
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
# Create this key yourself in the Zetaris web interface after installation.
ZETARIS_API_KEY=
# Optional: only required when downloading the Zetaris API specification.
ZETARIS_USERNAME=
ZETARIS_PASSWORD=

# NVIDIA direct API defaults. Generate a key at https://build.nvidia.com.
# Meterless is a separate memory service; NVIDIA remains the model provider.
MODEL_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL_API_KEY=
NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b

# Cool Sydney GIS dashboard. Blank Python path uses .venv/bin/python.
COOL_SYDNEY_PORT=8765
COOL_SYDNEY_PYTHON=
# Change only if your Zetaris REST version uses another SQL endpoint.
ZETARIS_SQL_PATH=/sql-editor/sqls/run

# LangGraph tools use the registered platform JDBC connection via Docker.
ZETARIS_DRIVER_CONTAINER=zetaris-driver-1
METERLESS_BASE_URL=http://127.0.0.1:8766

# Agent provider defaults to Gemini; choose per request in the dashboard.
MODEL_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
